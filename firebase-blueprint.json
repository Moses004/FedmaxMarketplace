{
  "entities": {
    "listings": {
      "title": "Property Listings",
      "description": "Real estate property listings stored permanently in Firestore",
      "fields": {
        "id": { "type": "string", "description": "Unique listing ID" },
        "title": { "type": "string", "description": "Listing title" },
        "description": { "type": "string", "description": "Listing description" },
        "price": { "type": "number", "description": "Monthly or annual price in USD" },
        "pricePeriod": { "type": "string", "description": "Price period (monthly, annual, night)" },
        "localPrice": { "type": "number", "description": "Price in local currency" },
        "currency": { "type": "string", "description": "Local currency code (NGN, EUR, GBP, USD, etc.)" },
        "type": { "type": "string", "description": "Property type category" },
        "location": { "type": "string", "description": "Full street address / neighborhood location string" },
        "country": { "type": "string", "description": "Country name" },
        "state": { "type": "string", "description": "State / Region name" },
        "city": { "type": "string", "description": "City name" },
        "lat": { "type": "number", "description": "Latitude coordinate" },
        "lng": { "type": "number", "description": "Longitude coordinate" },
        "bedrooms": { "type": "number", "description": "Number of bedrooms" },
        "bathrooms": { "type": "number", "description": "Number of bathrooms" },
        "size": { "type": "number", "description": "Property size in square meters" },
        "amenities": { "type": "array", "description": "List of property amenities" },
        "images": { "type": "array", "description": "List of photo image URLs" },
        "landlordId": { "type": "string", "description": "Owner / Manager ID" },
        "landlordName": { "type": "string", "description": "Owner / Manager contact name" },
        "contactPhone": { "type": "string", "description": "Contact phone number" },
        "createdAt": { "type": "number", "description": "Creation timestamp in MS" }
      }
    },
    "bookings": {
      "title": "Tour Bookings & Applications",
      "description": "Scheduled property tours and tenant rental applications",
      "fields": {
        "id": { "type": "string", "description": "Booking ID" },
        "listingId": { "type": "string", "description": "Target property listing ID" },
        "listingTitle": { "type": "string", "description": "Property title" },
        "userName": { "type": "string", "description": "Applicant / Tour attendee name" },
        "userEmail": { "type": "string", "description": "Applicant email" },
        "userPhone": { "type": "string", "description": "Applicant phone number" },
        "preferredDate": { "type": "string", "description": "Tour date" },
        "preferredTime": { "type": "string", "description": "Tour time slot" },
        "status": { "type": "string", "description": "Status (pending, confirmed, cancelled)" },
        "createdAt": { "type": "number", "description": "Booking creation timestamp" }
      }
    },
    "inquiries": {
      "title": "Inquiries & Messages",
      "description": "Messages sent to landlords regarding properties",
      "fields": {
        "id": { "type": "string", "description": "Inquiry ID" },
        "listingId": { "type": "string", "description": "Target listing ID" },
        "senderName": { "type": "string", "description": "Sender name" },
        "senderEmail": { "type": "string", "description": "Sender email" },
        "message": { "type": "string", "description": "Message content" },
        "createdAt": { "type": "number", "description": "Timestamp" }
      }
    }
  }
}
