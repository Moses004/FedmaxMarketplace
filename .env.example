# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: Optional. Configured via Secrets to enable live interactive Google Maps.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_PUBLIC_KEY / VITE_PAYSTACK_PUBLIC_KEY: Live or Test Paystack Public Key
PAYSTACK_PUBLIC_KEY="pk_live_c15894ff1baf558bb221c8131579660568467919"
VITE_PAYSTACK_PUBLIC_KEY="pk_live_c15894ff1baf558bb221c8131579660568467919"

# PAYSTACK_SECRET_KEY: Live or Test Paystack Secret Key for server-side verification and transaction initialization
PAYSTACK_SECRET_KEY="sk_live_ed2fabc2dc23fe848604449de8a9f70ba3998669"

# Supabase Integration Environment Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud SQL (PostgreSQL) Runtime Environment Variables
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
