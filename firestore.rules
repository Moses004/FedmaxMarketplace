rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and write access for property listings
    match /listings/{listingId} {
      allow read, write: if true;
    }
    
    // Allow public read and write access for tour bookings and applications
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Allow public write access for landlord inquiries
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Default rule for user profiles and other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
